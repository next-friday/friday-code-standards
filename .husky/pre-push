#!/usr/bin/env sh
set -eu

remote_name=$1
remote_url=$2
zero=$(git hash-object --stdin < /dev/null | tr '0-9a-f' '0')
has_push=0
has_heavy=0
head_oid=$(git rev-parse HEAD)

resolve_compare_branch() {
  candidate_ref="$remote_name/main"

  if git rev-parse --verify "$candidate_ref^{commit}" > /dev/null 2>&1; then
    printf '%s\n' "$candidate_ref"
    return
  fi

  for candidate_remote in $(git remote); do
    candidate_url=$(git remote get-url "$candidate_remote")
    candidate_ref="$candidate_remote/main"

    if [ "$candidate_url" = "$remote_url" ] \
      && git rev-parse --verify "$candidate_ref^{commit}" > /dev/null 2>&1; then
      printf '%s\n' "$candidate_ref"
      return
    fi
  done

  if git rev-parse --verify 'origin/main^{commit}' > /dev/null 2>&1; then
    printf '%s\n' "origin/main"
    return
  fi

  if git rev-parse --verify 'main^{commit}' > /dev/null 2>&1; then
    printf '%s\n' "main"
    return
  fi

  printf '%s\n' "pre-push verification could not resolve a local main comparison ref." >&2
  return 1
}

if ! command -v gitleaks > /dev/null 2>&1; then
  printf '%s\n' "pre-push verification requires gitleaks." >&2
  exit 1
fi

while IFS=' ' read -r local_ref local_oid remote_ref remote_oid || [ -n "${local_ref:-}" ]; do
  : "$local_ref" "$remote_ref"

  if [ "$local_oid" = "$zero" ]; then
    continue
  fi

  pushed_oid=$(git rev-parse "$local_oid^{commit}")
  if [ "$pushed_oid" != "$head_oid" ]; then
    printf '%s\n' \
      "pre-push verification requires every pushed ref to point to the checked-out commit." \
      "HEAD: $head_oid" \
      "Pushed commit: $pushed_oid" >&2
    exit 1
  fi

  has_push=1

  if [ "$remote_oid" = "$zero" ]; then
    log_opts="$local_oid --not --remotes=$remote_name"
  elif git cat-file -e "$remote_oid^{commit}" 2> /dev/null; then
    log_opts="$remote_oid..$local_oid"
  else
    log_opts="$local_oid --not --remotes=$remote_name"
  fi

  gitleaks git --redact --log-opts="$log_opts" .

  changed_files=$(git log -m --format= --name-only $log_opts -- \
    . \
    ':(exclude,glob)**/*.md' \
    ':(exclude)LICENSE' \
    ':(exclude,glob).changeset/**' \
    ':(exclude,glob).github/ISSUE_TEMPLATE/**' \
    ':(exclude).github/pull_request_template.md' \
    ':(exclude).github/CODEOWNERS' \
    ':(exclude).github/dependabot.yml' \
    ':(exclude).github/labeler.yml' \
    ':(exclude,glob).vscode/**' \
    ':(exclude,glob).claude/**' \
    ':(exclude,glob).agents/**' \
    ':(exclude)CLAUDE.md' \
    ':(exclude)AGENTS.md' \
    ':(exclude,glob)**/*.png' \
    ':(exclude,glob)**/*.svg' \
    ':(exclude,glob)**/*.jpg' \
    ':(exclude).gitignore')

  if printf '%s\n' "$changed_files" | grep -q .; then
    has_heavy=1
  fi
done

if [ "$has_push" -eq 0 ] || [ "$has_heavy" -eq 0 ]; then
  exit 0
fi

if [ -n "$(git status --porcelain)" ]; then
  printf '%s\n' "pre-push verification requires a clean working tree so coverage matches HEAD." >&2
  exit 1
fi

compare_branch=$(resolve_compare_branch)

pnpm verify
node scripts/check-patch-coverage.mjs --compare-branch "$compare_branch" --fail-under 95 packages/commitlint-config-friday/coverage/lcov.info packages/eslint-config-friday/coverage/lcov.info packages/prettier-config-friday/coverage/lcov.info
