{
  "name": "@next-friday/eslint-config-friday",
  "version": "3.0.0",
  "description": "Strict, type-aware ESLint Flat Config for JavaScript, TypeScript, React, and Node.js.",
  "keywords": [
    "eslint-config",
    "flat-config",
    "react",
    "strict",
    "typescript-eslint",
    "stylistic",
    "type-aware",
    "next-friday"
  ],
  "homepage": "https://github.com/next-friday/friday-code-standards/tree/main/packages/eslint-config-friday",
  "bugs": {
    "url": "https://github.com/next-friday/friday-code-standards/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/next-friday/friday-code-standards.git",
    "directory": "packages/eslint-config-friday"
  },
  "license": "MIT",
  "author": "Next Friday",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "audit": "pnpm audit",
    "build": "tsdown",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "clean:dist": "rimraf dist",
    "clean:test": "rimraf coverage",
    "dev": "tsdown --watch",
    "lint": "eslint . --fix --cache --max-warnings=0",
    "lint:check": "eslint . --cache --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.24.4",
    "@eslint/markdown": "8.0.3",
    "@next-friday/eslint-plugin-friday": "1.1.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-antfu": "3.2.3",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.1.0",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-package-json": "1.10.1",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-toml": "1.5.0",
    "eslint-plugin-unicorn": "77.0.0",
    "eslint-plugin-yml": "3.8.1",
    "globals": "17.13.0",
    "jsonc-eslint-parser": "3.3.0",
    "typescript-eslint": "8.71.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.13.0",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.4.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
